{
  "name": "birds-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 --webpack",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:perf": "npx playwright test --project='Desktop Chrome'",
    "test:perf:mobile": "npx playwright test --project='Mobile Chrome'",
    "test:perf:slow": "npx playwright test --project='Slow 3G'",
    "test:perf:all": "npx playwright test",
    "test:perf:report": "npx playwright show-report performance-reports",
    "test:perf:headed": "npx playwright test --headed --project='Desktop Chrome'",
    "test:perf:generate-report": "tsx scripts/generate-perf-report.ts",
    "db:generate": "npx prisma generate",
    "db:push": "echo '❌ db:push is disabled. Use npm run db:migrate instead. See docs/processes/DATABASE_SCHEMA_MANAGEMENT.md' && exit 1",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:create": "npx prisma migrate dev --create-only",
    "db:migrate:status": "npx prisma migrate status",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:migrate:reset": "npx prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-mock": "tsx prisma/seed-mock-data.ts",
    "db:make-admin": "tsx scripts/make-admin.ts",
    "db:check-migration": "tsx scripts/check-migration.ts",
    "db:studio": "npx prisma studio",
    "postinstall": "npx prisma generate && cd \"$(git rev-parse --show-toplevel 2>/dev/null)\" && git config core.hooksPath birds-app/.githooks 2>/dev/null || true",
    "local:start": "bash scripts/local-start.sh",
    "backfill:form-emails": "tsx scripts/backfill-form-emails.ts",
    "db:check-drift": "tsx scripts/check-drift.ts",
    "db:upsert-regions": "tsx prisma/upsert-regions.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-virtual": "^3.13.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.0",
    "googleapis": "^170.1.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
