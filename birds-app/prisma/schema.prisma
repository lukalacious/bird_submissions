// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")         // Pooled — used at runtime
  directUrl = env("DIRECT_DATABASE_URL")  // Non-pooled — used for migrations & introspection
}

// User model - stores authenticated users
model User {
  id               String                @id @default(cuid())
  email            String                @unique
  emailVerified    DateTime?             // Required by NextAuth for new user registration
  name             String?
  username         String?               @unique // Custom display name separate from OAuth
  image            String?
  role             Role                  @default(USER)
  defaultRegionId  String?               // User's preferred region for submissions
  defaultRegion    Region?               @relation("DefaultRegion", fields: [defaultRegionId], references: [id])
  invitedBy        User?                 @relation("Invites", fields: [invitedById], references: [id])
  invitedById      String?
  invitedUsers     User[]                @relation("Invites")
  submissions      Submission[]
  accounts         Account[]
  sessions         Session[]
  jokers           UserJoker[]
  challengeStatus  UserChallengeStatus[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

enum Role {
  USER
  ADMIN
}

// NextAuth Account model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Region model - stores available regions (e.g., South Africa, Northeast Europe)
model Region {
  id            String       @id @default(cuid())
  name          String       @unique // "south_africa" - used as identifier
  label         String       // "South Africa" - display name
  birds         Bird[]
  submissions   Submission[]
  usersDefault  User[]       @relation("DefaultRegion") // Users who have this as default
  createdAt     DateTime     @default(now())
}

// Bird model - stores bird species per region
model Bird {
  id               String   @id @default(cuid())
  alphabeticalName String   // "Albatross, Amsterdam"
  fullName         String   // "Amsterdam Albatross"
  scientificName   String   // "Diomedea amsterdamensis"
  groupName        String?  // Bird group for joker calculation (from "Group Name" column)
  region           Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  regionId         String
  createdAt        DateTime @default(now())

  @@unique([fullName, regionId])
  @@index([regionId])
  @@index([groupName])
}

// Submission model - stores individual bird submissions
// Each row = one bird submitted by one user for one region in one year and month
model Submission {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  region       Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  regionId     String
  birdName          String   // The full name of the bird submitted
  year              Int      // Year of submission
  month             Int      @default(1) // Month (1-12) for per-month cap and greying
  isCustomBird      Boolean  @default(false) // True if bird was not in predefined list
  isJokerSubmission Boolean  @default(false) // True if this is a joker immunity submission
  createdAt         DateTime @default(now())

  @@unique([userId, regionId, birdName, year, month])
  @@index([userId, regionId, year, month])
}

// Settings model - stores app-wide configuration
model Settings {
  id                    String      @id @default("default")
  maxBirdsPerPeriod     Int         @default(31)
  resetPeriod           ResetPeriod @default(YEARLY)
  currentYear           Int         @default(2026)
  monthlyFormEmbedUrl   String?     @db.Text  // Google Form embed URL
  eliminationThreshold  Int         @default(30)  // Min birds required to avoid elimination
  rules                 String?     @db.Text  // Game rules displayed on dashboard
  updatedAt             DateTime    @updatedAt
}

enum ResetPeriod {
  MONTHLY
  YEARLY
  NEVER
}

// MonthlySettings model - stores per-month submission requirements
model MonthlySettings {
  id                   String @id @default(cuid())
  year                 Int
  month                Int    // 1-12
  maxBirdsPerPeriod    Int    // Required submissions for this month
  eliminationThreshold Int?   // Optional: override elimination threshold for this month
  goldenBirds          String[] @default([]) // Bird names announced as golden birds this month
  photoBirds           String[] @default([]) // Bird names designated for photography bonuses

  @@unique([year, month])
  @@index([year])
}

// UserJoker model - tracks jokers earned from same-group submissions
model UserJoker {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  jokers      Float  @default(0)     // Group-based jokers (recalculated from submissions)
  bonusJokers Float  @default(0)     // Form-based bonus jokers (set by admin processing)
  totalJokers Float  @default(0)     // jokers + bonusJokers (precomputed for reads)
  usedJokers      Float  @default(0)     // Jokers used for immunity
  bonusBreakdown  Json?                 // e.g. [{"rule":"Golden birds (2)","value":2},{"rule":"Lifers (5)","value":5}]

  @@unique([userId, year, month])
  @@index([userId])
}

// ProcessingLog model - tracks when admin processes form jokers per month
model ProcessingLog {
  id             String   @id @default(cuid())
  type           String   // "bonus_jokers"
  year           Int
  month          Int
  processedAt    DateTime @default(now())
  processedBy    String   // Admin user ID
  matchedCount   Int      @default(0)
  unmatchedCount Int      @default(0)
  results        Json?    // Full FormJokerResult[] for viewing past processing results

  @@index([type, year, month])
}

// UserChallengeStatus model - tracks elimination status per user per year
model UserChallengeStatus {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  year             Int
  isEliminated     Boolean   @default(false)
  eliminatedAt     DateTime?
  eliminationMonth Int?      // Month when user was eliminated
  joinedMonth      Int       @default(1) // Month when user joined the challenge (for mid-year joins)

  @@unique([userId, year])
  @@index([userId])
  @@index([year, isEliminated])
}
